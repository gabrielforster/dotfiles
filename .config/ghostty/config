font-family = IoskeleyMonoTerm Nerd Font
font-size = 15

window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
background-opacity = 1.0

# Matches herdr's vesper theme. Previous colors backed up as
# themes/tomorrow-night — restore with: theme = tomorrow-night
theme = Vesper

mouse-hide-while-typing = true

# No GTK headerbar/titlebar — bare terminal surface
window-decoration = none

# shift+enter -> ESC CR
keybind = shift+enter=text:\x1b\r
